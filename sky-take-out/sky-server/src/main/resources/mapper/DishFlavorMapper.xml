<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.DishFlavorMapper">


    <insert id="insertBatch">
        insert into dish_flavor (dish_id, name, value)
        values
        <foreach collection="flavorList" item="ib" separator=",">
            (#{ib.dishId},#{ib.name},#{ib.value})
        </foreach>


    </insert>
<!--  delete from dish_flavor where dish_id in （1,2,3）  -->
    <delete id="deleteByDishIds" >
        delete from dish_flavor where dish_id
        <foreach collection="dish_ids" item="dishId" separator="," open="(" close=")">
            #{dishId}
        </foreach>
    </delete>


</mapper>

